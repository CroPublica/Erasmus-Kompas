---
import '../styles/global.css';
import meta from '../data/meta.json';
import { t, otherLang, type Lang } from '../lib/i18n';

interface Props { lang: Lang; title: string; path: string; active?: string; description?: string }
const { lang, title, path, active = '', description = '' } = Astro.props;
const s = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: Lang, p = path) => `${base}/${l}${p}`;
const nav = [
  ['coverage', '', s.nav.coverage],
  ['orgs', '/organisations/', s.nav.orgs],
  ['places', '/places/', s.nav.places],
] as const;
const soon = [s.nav.graph, s.nav.ask];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · KA2 Atlas</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang={otherLang(lang)} href={href(otherLang(lang))} />
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href(lang, '')}>{s.site}</a>
        <span class="tagline">{s.tagline}</span>
        <nav class="main" aria-label="Main">
          {soon[0] && <span title={s.soon}>{soon[0]}<small>{s.soon}</small></span>}
          {nav.map(([key, p, label]) => <a href={href(lang, p)} aria-current={active === key ? 'page' : undefined}>{label}</a>)}
          <span title={s.soon}>{soon[1]}<small>{s.soon}</small></span>
        </nav>
        <div class="lang" role="group" aria-label={s.other}>
          <a href={href('hr')} hreflang="hr" lang="hr" aria-current={lang === 'hr' ? 'true' : undefined}>HR</a>
          <a href={href('en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
      </div>
    </header>
    <main id="main"><div class="wrap"><slot /></div></main>
    <footer class="site"><div class="wrap">
      <p>{s.provenance}</p>
      <p class="mono">{meta.generated}</p>
    </div></footer>
  </body>
</html>

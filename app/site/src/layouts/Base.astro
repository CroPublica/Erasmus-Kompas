---
import '../styles/legacy.css';
import '../styles/tokens.css';
import '../styles/ecl.css';
import '../styles/extra.css';
import meta from '../data/meta.json';
import Logo from '../components/Logo.astro';
import { t, otherLang, type Lang } from '../lib/i18n';
import { ch } from '../lib/chrome';
import { NAV, ICON, findActive } from '../lib/nav';

interface Props { lang: Lang; title: string; path: string; active?: string; description?: string; crumbs?: [string, string?][]; landing?: boolean; ek?: boolean }
const { lang, title, path, active = '', description = '', crumbs, landing = false, ek = false } = Astro.props;
const s = t(lang), c = ch(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: Lang, p = path) => `${base}/${l}${p || '/'}`;
const to = (p: string) => `${base}/${lang}${p === '/' ? '/' : p}`;
const here = findActive(active);
// Breadcrumb: Atlas / section / page, or what the page passes (label, optional link)
const trail: [string, string?][] = crumbs ?? [
  ...(here.top && here.top.key !== 'home' ? [[here.top.label[lang], here.top.subs.length ? undefined : to(here.top.href)] as [string, string?]] : []),
  ...(here.sub ? [[here.sub.label[lang]] as [string]] : []),
];
const tabs = here.top && here.top.subs.length > 1 ? here.top.subs : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title} · Erasmus+ Kompas</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang={otherLang(lang)} href={href(otherLang(lang))} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <script is:inline>try{var t=localStorage.getItem('ek-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  </head>
  <body data-base={base} data-scrollable={c.scrollable}>
    <a class="skip" href="#main">{s.skip}</a>
    <div class="layout">
      <aside class="side" id="side" aria-label={c.menu} translate="no">
        <div class="sidein">
          <div class="sidehead"><button type="button" id="sideclose" aria-label={c.closeMenu}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
          <a class="brand" href={to('/')} aria-label={`Erasmus+ Kompas, ${s.nav.coverage}`}>
            <Logo size={48} />
            <span><b>Erasmus+ Kompas</b><small>{c.tagline}</small></span>
          </a>
          <div class="sidetools">
            <div class="lang" role="group" aria-label={c.lang}>
              <a href={href('hr')} hreflang="hr" lang="hr" aria-current={lang === 'hr' ? 'true' : undefined} title="Hrvatski">HR</a>
              <a href={href('en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} title="English">EN</a>
            </div>
            <button type="button" class="themebtn" id="theme" aria-label={c.toDark} data-to-dark={c.toDark} data-to-light={c.toLight}>
              <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
              <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
          </div>
          <nav id="nav" aria-label={c.nav}>
            {NAV.map((top) => (
              <div class={`grp${top.subs.length ? ' has-sub' : ''}`}>
                <a class="top" href={to(top.href)} aria-current={here.top?.key === top.key && !here.sub ? 'page' : undefined}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[top.icon]} />
                  <span>{top.label[lang]}</span>
                </a>
                {top.subs.length > 0 && (
                  <ul class="subs" aria-label={top.label[lang]}>
                    {top.subs.map((sub) => <li><a class="sub" href={to(sub.href)} aria-current={here.sub?.key === sub.key ? 'page' : undefined}>{sub.label[lang]}</a></li>)}
                  </ul>
                )}
              </div>
            ))}
          </nav>
          <div class="askcard">
            <b>{c.askTitle}</b>
            <span>{c.askText}</span>
            <button type="button" class="askbtn" id="side-ask">{c.askBtn}</button>
          </div>
          <p class="sidefoot">{c.notOfficial}</p>
        </div>
        <i class="wave" aria-hidden="true"></i>
      </aside>

      <div class="main">
        <div class="topbar">
          <button class="tb" id="menu" type="button" aria-expanded="false" aria-controls="side" aria-label={c.menu}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <a class="tbrand" href={to('/')}><Logo size={40} /><span>Erasmus+ Kompas</span></a>
          <button type="button" class="tb ask" id="tb-ask" aria-label={c.assistant}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg></button>
        </div>
        <main id="main" tabindex="-1">
          {landing ? <slot /> : (
            <div class="wrap page">
              <div class="pagebar">
                <nav class="crumbs" aria-label={c.path}>
                  <a href={to('/')}>{c.atlas}</a>
                  {trail.map(([l, h]) => (h ? <a href={h}>{l}</a> : <span aria-current={undefined}>{l}</span>))}
                </nav>
                <form class="gsearch" role="search" onsubmit="return false">
                  <svg class="gi" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                  <label class="sr" for="gs">{c.searchLabel}</label>
                  <input id="gs" type="search" role="combobox" aria-autocomplete="list" placeholder={c.searchPh} autocomplete="off" aria-controls="gs-res" aria-expanded="false" />
                  <kbd aria-hidden="true">/</kbd>
                  <div class="gres" id="gs-res" hidden></div>
                </form>
              </div>
              {tabs.length > 0 && <nav class="tabs2" aria-label={here.top!.label[lang]}>{tabs.map((t) => <a href={to(t.href)} aria-current={here.sub?.key === t.key ? 'page' : undefined}>{t.label[lang]}</a>)}</nav>}
              <div class={ek ? 'ekslot' : 'legacy'}><slot /></div>
            </div>
          )}
        </main>
      </div>
    </div>
    <section class="dock" id="dock" role="dialog" aria-labelledby="dock-title" aria-modal="false" translate="no">
      <header class="dock-head">
        <span class="avatar" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 40 40"><path d="M20 4l5 16-5 16-5-16z" fill="#ffd617"/><path d="M4 20l16-5 16 5-16 5z" fill="#fff"/></svg></span>
        <h2 id="dock-title">{c.dockTitle}<small>{c.dockSub}</small></h2>
        <button type="button" class="ic" id="dock-new" title={c.dockNew} aria-label={c.dockNew}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
        <a class="ic" href={to('/ask/')} title={c.dockFull} aria-label={c.dockFull}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-8 8M10 6H5v13h13v-5"/></svg></a>
        <button type="button" class="ic" id="dock-close" title={c.dockClose} aria-label={c.dockClose}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </header>
      <div class="dock-ctx" id="dock-ctx"></div>
      <div class="dock-log" id="dock-log" role="log" aria-live="polite"></div>
      <form class="dock-form" id="dock-form">
        <label class="sr" for="dock-q">{c.dockQ}</label>
        <div class="composer"><textarea id="dock-q" rows="1" maxlength="500" placeholder={c.dockPh} required></textarea><button class="send" type="submit" id="dock-go" aria-label={c.dockSend}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5"/></svg></button></div>
        <small>{c.dockNote}</small>
      </form>
    </section>
    <button class="edgetab" id="edgetab" type="button" aria-controls="dock" aria-expanded="false"><span>{c.assistant}</span></button>
    <div class="scrim" id="scrim" hidden></div>

    <footer class="site" translate="no">
      <div class="finner">
        <div class="fcol fbrand">
          <a class="fb" href={to('/')}><Logo size={34} invert /><span>Erasmus+ Kompas</span></a>
          <p>{c.fbrand}</p>
        </div>
        <div class="fcol">
          <h2>{c.sources}</h2>
          <ul class="srcs">
            <li><a href="https://erasmus-plus.ec.europa.eu/projects/projects-lists" target="_blank" rel="noopener noreferrer">{c.src1[0]}</a><span>{c.src1[1]}</span></li>
            <li><a href="https://data.gov.hr/ckan/hr/dataset/program-erasmus-za-razdoblje-od-2021-do-2027-godine" target="_blank" rel="noopener noreferrer">{c.src2[0]}</a><span>{c.src2[1]}</span></li>
            <li><a href="https://data.gov.hr/ckan/hr/dataset/osnovne-skole" target="_blank" rel="noopener noreferrer">{c.src3[0]}</a><span>{c.src3[1]}</span></li>
          </ul>
        </div>
        <div class="fcol">
          <h2>{c.about}</h2>
          <dl class="meta2">
            <div><dt>{c.updated}</dt><dd><time>{meta.generated}</time></dd></div>
            <div><dt>{c.scope}</dt><dd>{c.scopeText}</dd></div>
            <div><dt>{c.calc}</dt><dd>{c.calcText}</dd></div>
          </dl>
        </div>
        <div class="fcol">
          <h2>{c.atlasH}</h2>
          <ul class="flinks">
            <li><a href={to('/ask/')}>{c.assistant}</a></li>
            <li><a href="https://github.com/CroPublica/Erasmus-Kompas" target="_blank" rel="noopener noreferrer">{c.sourceCode}</a></li>
          </ul>
        </div>
      </div>
      <div class="fbottom"><p>{c.legal}</p></div>
    </footer>
  </body>
</html>
<script>
  import { slug } from '../lib/i18n';
  // ---- the views and the assistant of the v8 design run from one script; it loads once, when a page or a click needs it
  const w = window as any;
  w.EKLoad = w.EKLoad || (() => { let p: Promise<void> | null = null; return () => p ||= (async () => {
    const b = document.body.dataset.base || '';
    w.EK_ASK_API = `${b}/api/ask`; w.EK_DATA_BASE = `${b}/ek/`;
    w.__EK_D = await (await fetch(`${b}/ek/D.json`)).json();
    await new Promise<void>((ok, bad) => { const sc = document.createElement('script'); sc.src = `${b}/ek/ek.js`; sc.onload = () => ok(); sc.onerror = () => bad(new Error('ek.js')); document.head.append(sc); });
  })(); })();
  const view = document.getElementById('view');
  if (view?.dataset.view) w.EKLoad().then(() => w.EK.mount(view.dataset.view, view.dataset.arg)).catch(() => { view.innerHTML = '<p class="note">Error.</p>'; });
  else ['edgetab', 'side-ask', 'tb-ask'].forEach((id) => document.getElementById(id)?.addEventListener('click', () => { if (!w.EK) w.EKLoad().then(() => w.EK.assistant().open()); }, { once: true }));
  // ---- menu drawer on small screens
  const body = document.body;
  const menu = document.getElementById('menu')!, scrim = document.getElementById('scrim')!;
  const setNav = (open: boolean) => { body.classList.toggle('navopen', open); scrim.hidden = !open; menu.setAttribute('aria-expanded', String(open)); };
  menu.addEventListener('click', () => setNav(!body.classList.contains('navopen')));
  document.getElementById('sideclose')!.addEventListener('click', () => { setNav(false); menu.focus(); });
  scrim.addEventListener('click', () => setNav(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && body.classList.contains('navopen')) { setNav(false); menu.focus(); } });
  // ---- regions that scroll sideways must be reachable from the keyboard
  const markScrollable = () => document.querySelectorAll<HTMLElement>('main *').forEach((el) => {
    if (el.scrollWidth > el.clientWidth + 1 && /(auto|scroll)/.test(getComputedStyle(el).overflowX) && !el.hasAttribute('tabindex')) {
      el.tabIndex = 0; el.setAttribute('role', 'region'); if (!el.hasAttribute('aria-label')) el.setAttribute('aria-label', body.dataset.scrollable!);
    }
  });
  markScrollable(); addEventListener('load', markScrollable); addEventListener('resize', markScrollable);
  { let mt = 0; const v = document.getElementById('view'); if (v) new MutationObserver(() => { clearTimeout(mt); mt = window.setTimeout(markScrollable, 250); }).observe(v, { childList: true, subtree: true }); }
  // ---- theme: light or dark, remembered; without a choice the system setting applies
  const themeBtn = document.getElementById('theme')!;
  const isDark = () => document.documentElement.dataset.theme === 'dark' || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
  const paintTheme = () => { const d = isDark(); themeBtn.setAttribute('aria-pressed', String(d)); themeBtn.setAttribute('aria-label', d ? themeBtn.dataset.toLight! : themeBtn.dataset.toDark!); themeBtn.title = themeBtn.getAttribute('aria-label')!; };
  themeBtn.addEventListener('click', () => { const next = isDark() ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('ek-theme', next); } catch { /* private mode */ } paintTheme(); });
  paintTheme();
  // ---- search in the top bar (organisations, from search.json)
  const input = document.getElementById('gs') as HTMLInputElement | null;
  if (input) {                                                          // the landing page has its own search inside the view
  const list = document.getElementById('gs-res') as HTMLDivElement;
  const lang = document.documentElement.lang;
  const base = body.dataset.base || '';
  let idx: [string, string, string][] | null = null;
  const fold = (x: string) => x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd');
  async function load() { if (!idx) idx = await (await fetch(`${base}/search.json`)).json(); return idx!; }
  const close = () => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); };
  input.addEventListener('focus', load);
  input.addEventListener('input', async () => {
    const q = fold(input.value.trim());
    const data = await load();
    list.innerHTML = '';
    if (q.length < 2) { close(); return; }
    const hits = data.filter(([, n, t]) => fold(`${n} ${t}`).includes(q)).slice(0, 8);
    for (const [id, n, t] of hits) {
      const a = document.createElement('a');
      a.href = `${base}/${lang}/organisations/${slug(id)}/`;
      const sp = document.createElement('span'); sp.textContent = n; a.append(sp);
      if (t) { const sm = document.createElement('small'); sm.textContent = t; a.append(sm); }
      list.append(a);
    }
    list.hidden = hits.length === 0;
    input.setAttribute('aria-expanded', String(hits.length > 0));
  });
  input.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); if (e.key === 'ArrowDown') (list.querySelector('a') as HTMLElement | null)?.focus(); });
  list.addEventListener('keydown', (e) => {
    const a = document.activeElement as HTMLElement;
    if (e.key === 'ArrowDown') { (a.nextElementSibling as HTMLElement | null)?.focus(); e.preventDefault(); }
    if (e.key === 'ArrowUp') { ((a.previousElementSibling as HTMLElement | null) ?? input).focus(); e.preventDefault(); }
    if (e.key === 'Escape') { close(); input.focus(); }
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.gsearch')) close(); });
  document.addEventListener('keydown', (e) => {                       // "/" focuses the search, like in the prototype
    const t = e.target as HTMLElement;
    if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) { e.preventDefault(); input.focus(); }
  });
  }
</script>

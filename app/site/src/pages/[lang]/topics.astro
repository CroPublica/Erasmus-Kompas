---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Teme kroz vrijeme', 'Kako su se teme mijenjale kroz godine.'], en: ['Topics over time', 'How topics changed over the years.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/topics/" active="topics" description={T[1]}>
  <EkView view="topics" lang={lang} />
</Base>

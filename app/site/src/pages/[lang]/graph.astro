---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Mreža pojmova', 'Pojmovi koji se u projektima pojavljuju zajedno: pristupi, ciljne skupine, rezultati, problemi i teme.'], en: ['Concept network', 'Concepts that appear together in projects: approaches, target groups, outputs, problems and topics.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/graph/" active="graph" description={T[1]}>
  <EkView view="graph" lang={lang} />
</Base>

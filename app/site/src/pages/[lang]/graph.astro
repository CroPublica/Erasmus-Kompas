---
import Base from '../../layouts/Base.astro';
import g from '../../data/graph.json';
import { LANGS, t, num, pct, type Lang } from '../../lib/i18n';
import { ct } from '../../lib/conceptText';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t(lang);
const c = ct(lang);
const pick = (a: [string, string | null] | undefined) => (a ? (lang === 'hr' && a[1] ? a[1] : a[0]) : '');
const title = (k: any) => [k.top_approach[0], k.top_target_group[0], k.top_topic[0]].filter(Boolean).slice(0, 2).map(pick).join(' · ');
const lists = [['top_approach', 'approach'], ['top_target_group', 'target_group'], ['top_output', 'output'], ['top_problem', 'problem'], ['top_topic', 'topic']] as const;
---
<Base lang={lang} title={c.gTitle} path="/graph/" active="graph" description={c.gLead}>
  <div class="kicker">{c.gKicker}</div>
  <h1>{c.gTitle}</h1>
  <p class="lead">{c.gLead}</p>
  <p class="lead" style="font-size:.9rem;margin-top:8px">{c.gCaveat}</p>

  <h2 style="margin-top:28px">{c.gPick}</h2>
  <div class="grid two-eq" style="margin-top:10px">
    <section class="card">
      <label for="cs">{c.gSearch}</label>
      <input id="cs" type="search" autocomplete="off" style="width:100%;margin:8px 0" aria-controls="cres" />
      <ul id="cres" style="list-style:none;padding:0;margin:0;max-height:360px;overflow:auto"></ul>
      <p class="lead" id="cnone" hidden>{c.gNoMatch}</p>
    </section>
    <section class="card" id="cpanel" aria-live="polite">
      <div class="kicker">{c.gSelected}</div>
      <p class="lead" id="chint">{c.gSearch}</p>
      <div id="cbody" hidden></div>
    </section>
  </div>

  <h2 style="margin-top:32px">{c.gGroups}</h2>
  <p class="lead">{c.gGroupsLead}</p>
  <div class="grid" style="margin-top:12px">
    {(g.communities as any[]).map((k) => (
      <details class="card" open={false}>
        <summary style="cursor:pointer">
          <b>{title(k)}</b>
          <span class="mono"> · {num(lang, k.n)} {c.gProjects} ({pct(lang, k.share, 0)} %)</span>
        </summary>
        <p class="lead" style="font-size:.9rem;margin:8px 0">
          2014–2020: {num(lang, k.p1)} · 2021–2027: {num(lang, k.p2)} · {c.gGp}: {num(lang, k.gp)} {c.gOf} {num(lang, k.n)} ({pct(lang, k.gp / k.n, 0)} %; {pct(lang, k.gp_lo, 0)}–{pct(lang, k.gp_hi, 0)})
        </p>
        <div class="grid three">
          {lists.map(([key, kind]) => k[key].length > 0 && (
            <div><div class="kicker">{(c.gKinds as any)[kind]}</div>
              <ul style="padding-left:18px;margin:6px 0 0">{k[key].slice(0, 5).map((a: any) => <li>{pick(a)}</li>)}</ul></div>
          ))}
        </div>
      </details>
    ))}
  </div>
</Base>
<script>
  import g from '../../data/graph.json';
  import { ct } from '../../lib/conceptText';
  const lang = (document.documentElement.lang === 'hr' ? 'hr' : 'en') as 'hr' | 'en';
  const c = ct(lang);
  type N = [string, string, string, string | null, number, number, number, number, number, number, string];
  const nodes = g.nodes as unknown as N[];
  const nf = new Intl.NumberFormat(lang === 'hr' ? 'hr-HR' : 'en-GB');
  const pc = (x: number) => nf.format(Math.round(x * 100));
  const name = (n: N) => (lang === 'hr' && n[3] ? n[3] : n[2]);
  const fold = (x: string) => x.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').toLowerCase();
  const search = nodes.map((n) => fold(`${n[2]} ${n[3] ?? ''}`));
  const neigh: Map<number, [number, number, number][]> = new Map();
  for (const [a, b, n, lift] of g.edges as number[][]) {
    for (const [x, y] of [[a, b], [b, a]]) {
      const cos = n / Math.sqrt(nodes[x][4] * nodes[y][4]);
      if (!neigh.has(x)) neigh.set(x, []);
      neigh.get(x)!.push([y, n, cos]);
    }
  }
  const input = document.getElementById('cs') as HTMLInputElement;
  const res = document.getElementById('cres') as HTMLUListElement;
  const none = document.getElementById('cnone')!;
  const body = document.getElementById('cbody')!;
  const hint = document.getElementById('chint')!;
  const esc = (x: string) => x.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]!));
  function show(i: number) {
    const n = nodes[i];
    const rel = (neigh.get(i) ?? []).sort((p, q) => q[2] - p[2]);
    const comm = (g.communities as any[]).find((k) => k.id === n[10]);
    const kinds = (c.gKinds as Record<string, string>);
    const groups = ['target_group', 'approach', 'output', 'problem', 'topic'].map((kd) => {
      const items = rel.filter((r) => nodes[r[0]][1] === kd).slice(0, 5);
      return items.length ? `<div><div class="kicker">${kinds[kd]}</div><ul style="padding-left:18px;margin:6px 0 10px">${items.map((r) =>
        `<li><button type="button" class="linkish" data-i="${r[0]}">${esc(name(nodes[r[0]]))}</button> <span class="mono">· ${c.gTogether} ${nf.format(r[1])}</span></li>`).join('')}</ul></div>` : '';
    }).join('');
    body.innerHTML = `<h3 style="margin:4px 0">${esc(name(n))}</h3>
      <p class="lead" style="margin:0 0 8px">${(c.gKindOne as Record<string, string>)[n[1]]} · ${nf.format(n[4])} ${c.gProjects} (${pc(n[4] / g.projects)} %)</p>
      <p class="lead" style="font-size:.9rem;margin:0 0 8px">${c.gPeriods}: 2014–2020 ${nf.format(n[5])} · 2021–2027 ${nf.format(n[6])} · ${c.gGp}: ${nf.format(n[7])} (${pc(n[7] / n[4])} %; ${pc(n[8])}–${pc(n[9])}; ${pc(g.gp_rate_all)} % ${lang === 'hr' ? 'svi projekti' : 'all projects'})</p>
      ${comm ? `<p class="lead" style="font-size:.9rem;margin:0 0 8px">${c.gGroup}: ${esc([comm.top_approach[0], comm.top_target_group[0], comm.top_topic[0]].filter(Boolean).slice(0, 2).map((a: any) => (lang === 'hr' && a[1] ? a[1] : a[0])).join(' · '))}</p>` : ''}
      <div style="margin-top:8px"><div class="kicker" style="margin-bottom:6px">${c.gGoes}</div>${groups}</div>`;
    body.hidden = false; hint.hidden = true;
    body.querySelectorAll<HTMLButtonElement>('button[data-i]').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.i)); document.getElementById('cpanel')!.scrollIntoView({ block: 'nearest' }); }));
  }
  function find() {
    const q = fold(input.value.trim());
    res.innerHTML = '';
    if (q.length < 2) { none.hidden = true; return; }
    const hits: number[] = [];
    for (let i = 0; i < nodes.length && hits.length < 40; i++) if (search[i].includes(q)) hits.push(i);
    for (const i of hits) {
      const li = document.createElement('li');
      li.innerHTML = `<button type="button" class="linkish" data-i="${i}">${esc(name(nodes[i]))}</button> <span class="mono">· ${(c.gKindOne as Record<string, string>)[nodes[i][1]]} · ${nf.format(nodes[i][4])}</span>`;
      li.querySelector('button')!.addEventListener('click', () => show(i));
      res.append(li);
    }
    none.hidden = hits.length > 0;
  }
  input.addEventListener('input', find);
  function fromHash() {                                    // links from Ask answers: /graph/#<concept id>
    const id = decodeURIComponent(location.hash.slice(1));
    const i = nodes.findIndex((n) => n[0] === id);
    if (i >= 0) show(i);
  }
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>

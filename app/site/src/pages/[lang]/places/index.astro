---
import Base from '../../../layouts/Base.astro';
import EkView from '../../../components/EkView.astro';
import { LANGS, type Lang } from '../../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Županije', 'Karta županija i poredak.'], en: ['Counties', 'County map and ranking.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/places/" active="places" description={T[1]}>
  <EkView view="places" lang={lang} />
</Base>

---
import Base from '../../layouts/Base.astro';
import { LANGS, t, type Lang } from '../../lib/i18n';
import { renderCoverage } from '../../lib/coverageView';
import type { State } from '../../lib/stats';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const init: State = { type: 'both', period: 'all', role: 'any' };
const v = renderCoverage(lang, init, base);
const groups = [
  ['type', s.institutions, [['both', s.both], ['primary', s.primary], ['secondary', s.secondary], ['kindergarten', s.kindergarten]]],
  ['period', s.periodLbl, [['all', s.pAll], ['2014-2020', s.p1], ['2021-2027', s.p2]]],
  ['role', s.roleLbl, [['any', s.anyRole], ['coordinator', s.coordOnly]]],
] as const;
---
<Base lang={lang} title={s.coverageTitle} path="" active="coverage" description={s.coverageLead}>
  <div class="headrow">
    <div>
      <div class="kicker">{s.coverageKicker}</div>
      <h1>{s.coverageTitle}</h1>
      <p class="lead">{s.coverageLead}</p>
    </div>
    <div id="headline" set:html={v.headline} />
  </div>
  <hr class="rule" />
  <div class="seg-group" id="filters">
    {groups.map(([key, label, opts]) => (
      <div>
        <div class="kicker">{label}</div>
        <div class="seg" role="group" aria-label={label} style="margin-top:8px">
          {opts.map(([val, text], i) => <button type="button" data-key={key} data-val={val} aria-pressed={i === 0 ? 'true' : 'false'}>{text}</button>)}
        </div>
      </div>
    ))}
  </div>

  <div class="grid two-eq" style="margin-top:20px">
    <div class="card">
      <h2>{s.byCounty}</h2>
      <p class="lead">{s.byCountyLead}</p>
      <div class="tiles" id="tiles" role="group" aria-label={s.byCounty} set:html={v.tiles} />
      <div class="legend"><span>{s.shareOfSchools}</span><span id="legend" style="display:contents" set:html={v.legend} /></div>
    </div>
    <div class="card">
      <h2>{s.ranked}</h2>
      <p class="lead">{s.rankedLead}</p>
      <div class="rank head"><span>{s.county.toUpperCase()}</span><span id="axis">{v.axis}</span><span class="n">{s.schools.toUpperCase()}</span><span class="n">{s.expected.toUpperCase()}</span></div>
      <div role="list" id="rank" set:html={v.rank} />
    </div>
  </div>

  <div class="selected" id="selected" hidden aria-live="polite">
    <div>
      <div class="kicker">{s.selected} · <span id="sel-name"></span></div>
      <p id="sel-text"></p>
    </div>
    <div><a class="primary" id="sel-open" href="#">{s.openCounty}</a></div>
  </div>
  <p class="method">{s.method}</p>
  <p class="method" style="border:0;margin-top:0">{s.partial}</p>
</Base>

<script>
  import { renderCoverage } from '../../lib/coverageView';
  import type { State } from '../../lib/stats';
  import type { Lang } from '../../lib/i18n';
  const lang = document.documentElement.lang as Lang;
  const base = document.body.dataset.base || '';
  const st: State = { type: 'both', period: 'all', role: 'any' };
  let county = '';
  const $ = (id: string) => document.getElementById(id)!;
  function paint() {
    const v = renderCoverage(lang, st, base);
    $('tiles').innerHTML = v.tiles; $('legend').innerHTML = v.legend; $('rank').innerHTML = v.rank; $('axis').textContent = v.axis; $('headline').innerHTML = v.headline;
    document.querySelectorAll<HTMLElement>('#filters button').forEach((b) =>
      b.setAttribute('aria-pressed', String((st as any)[b.dataset.key!] === b.dataset.val)));
    document.querySelectorAll<HTMLElement>('#tiles .tile').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.county === county)));
    document.querySelectorAll<HTMLElement>('#rank [data-rank]').forEach((r) => r.setAttribute('aria-selected', String(r.dataset.rank === county)));
    const tile = county ? document.querySelector<HTMLElement>(`#tiles .tile[data-county="${county}"]`) : null;
    $('selected').hidden = !tile;
    if (tile) {
      $('sel-name').textContent = (tile.dataset.label || '').toUpperCase();
      $('sel-text').textContent = tile.dataset.summary || '';
      ($('sel-open') as HTMLAnchorElement).href = tile.dataset.href || '#';
    }
  }
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('#filters button, [data-county]');
    if (!el) return;
    const from = el.closest('#rank') ? '#rank' : el.closest('#tiles') ? '#tiles' : '';
    if (el.dataset.key) (st as any)[el.dataset.key] = el.dataset.val;
    else county = el.dataset.county || '';
    paint();
    // the tiles and the ranking are redrawn, so give keyboard focus back to the same county
    if (from) document.querySelector<HTMLElement>(`${from} [data-county="${county}"]`)?.focus();
  });
</script>

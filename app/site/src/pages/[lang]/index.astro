---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Erasmus+ Kompas', 'Atlas sudjelovanja Hrvatske u Erasmus+ KA2 partnerstvima.'], en: ['Erasmus+ Kompas', 'Atlas of Croatia in Erasmus+ KA2 partnerships.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="" active="home" description={T[1]} landing>
  <EkView view="landing" lang={lang} />
</Base>

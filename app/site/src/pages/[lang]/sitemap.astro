---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Mapa stranice', 'Sve stranice atlasa.'], en: ['Site map', 'All pages of the atlas.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/sitemap/" active="" description={T[1]}>
  <EkView view="sitemap" lang={lang} />
</Base>

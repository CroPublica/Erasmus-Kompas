---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Pregled', 'Ključni pokazatelji KA2 partnerstava s hrvatskim sudionikom.'], en: ['Overview', 'Key figures of KA2 partnerships with a Croatian participant.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/overview/" active="overview" description={T[1]}>
  <EkView view="overview" lang={lang} />
</Base>

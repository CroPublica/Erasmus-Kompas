---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Asistent', 'Pitajte asistenta o podacima atlasa.'], en: ['Assistant', 'Ask the assistant about the atlas data.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/ask/" active="ask" description={T[1]}>
  <EkView view="ask" lang={lang} />
</Base>

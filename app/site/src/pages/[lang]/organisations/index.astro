---
import Base from '../../../layouts/Base.astro';
import EkView from '../../../components/EkView.astro';
import { LANGS, type Lang } from '../../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Organizacije', 'Organizacije u KA2 partnerstvima.'], en: ['Organisations', 'Organisations in KA2 partnerships.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/organisations/" active="orgs" description={T[1]}>
  <EkView view="organisations" lang={lang} />
</Base>

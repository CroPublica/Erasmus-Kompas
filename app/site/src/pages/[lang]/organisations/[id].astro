---
import Base from '../../../layouts/Base.astro';
import EkView from '../../../components/EkView.astro';
import full from '../../../data/orgs_full.json';
import { LANGS, slug, type Lang } from '../../../lib/i18n';
export const getStaticPaths = () =>
  LANGS.flatMap((lang) => Object.values(full as Record<string, any>).map((o) => ({ params: { lang, id: slug(o.org_id) }, props: { o } })));
const lang = Astro.params.lang as Lang;
const { o } = Astro.props as { o: any };
---
<Base ek lang={lang} title={o.name} path={`/organisations/${slug(o.org_id)}/`} active="orgs" description={o.name}>
  <EkView view="org" lang={lang} arg={slug(o.org_id)} />
</Base>

---
import Base from '../../layouts/Base.astro';
import EkView from '../../components/EkView.astro';
import { LANGS, type Lang } from '../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Pokrivenost škola', 'Koliko škola sudjeluje u KA2 partnerstvima.'], en: ['School coverage', 'How many schools take part in KA2 partnerships.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/coverage/" active="coverage" description={T[1]}>
  <EkView view="coverage" lang={lang} />
</Base>

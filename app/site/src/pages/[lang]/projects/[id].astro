---
import Base from '../../../layouts/Base.astro';
import EkView from '../../../components/EkView.astro';
import projects from '../../../data/projects_full.json';
import { LANGS, slug, type Lang } from '../../../lib/i18n';
export const getStaticPaths = () =>
  LANGS.flatMap((lang) => Object.values(projects as Record<string, any>).map((p) => ({ params: { lang, id: slug(p.project_id) }, props: { p } })));
const lang = Astro.params.lang as Lang;
const { p } = Astro.props as { p: any };
---
<Base ek lang={lang} title={p.title} path={`/projects/${slug(p.project_id)}/`} active="projects" description={p.title}>
  <EkView view="project" lang={lang} arg={slug(p.project_id)} />
</Base>

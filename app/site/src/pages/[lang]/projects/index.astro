---
import Base from '../../../layouts/Base.astro';
import EkView from '../../../components/EkView.astro';
import { LANGS, type Lang } from '../../../lib/i18n';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const T = { hr: ['Projekti', 'Pretražite KA2 projekte s hrvatskim sudionikom.'], en: ['Projects', 'Search KA2 projects with a Croatian participant.'] }[lang];
---
<Base ek lang={lang} title={T[0]} path="/projects/" active="projects" description={T[1]}>
  <EkView view="projects" lang={lang} />
</Base>

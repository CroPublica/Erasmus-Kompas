---
import Base from '../layouts/Base.astro';
const lang = 'hr';
---
<Base lang={lang} title="404" path="" active="" ek>
  <div class="wrap page" style="padding-block:40px">
    <div class="kicker">404</div>
    <h1>Stranica nije pronađena <span lang="en" style="font-weight:400;font-size:.6em;color:var(--muted)">/ Page not found</span></h1>
    <p class="lead">Adresa ne postoji ili je premještena. / The address does not exist or has moved.</p>
    <p style="margin-top:22px"><a class="btn primary" href="/hr/">Početna</a> <a class="btn" href="/en/">Home (English)</a></p>
  </div>
</Base>

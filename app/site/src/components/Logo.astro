---
// The compass mark of Erasmus+ Kompas: a drawn placeholder until an official logo exists. Replace the paths here, it is used on three places.
interface Props { size?: number; invert?: boolean }
const { size = 40, invert = false } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <circle cx="20" cy="20" r="18" fill={invert ? '#ffffff' : '#004494'} />
  {!invert && <circle cx="20" cy="20" r="16" fill="none" stroke="#fff" stroke-width="1.2" opacity=".55" />}
  <path d="M20 6l4.2 14L20 34l-4.2-14z" fill={invert ? '#004494' : '#ffd617'} />
  <path d="M6 20l14-4.2L34 20l-14 4.2z" fill={invert ? '#ffd617' : '#fff'} />
</svg>

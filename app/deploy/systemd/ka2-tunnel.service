[Unit]
Description=KA2 Atlas Cloudflare quick tunnel (a new https address at every start: see deploy/public_demo.sh url)
After=network-online.target

[Service]
ExecStart=@CLOUDFLARED@ tunnel --no-autoupdate --url http://127.0.0.1:8080
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
